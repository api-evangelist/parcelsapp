      {
        "name": "track_shipment",
        "title": "Track a shipment",
        "description": "Use this when the user provides a tracking number or supported tracking URL and asks to track, locate, check, monitor, or update the status of one package, parcel, shipment, or delivery. This includes questions about where a shipment is, whether it was delivered, or when it may arrive, with or without a named carrier such as UPS, FedEx, DHL, USPS, Royal Mail, or China Post. Parcels detects the carrier and returns cached or live status, events, route, weight, transit time, and available shipment attributes. A carrier may return state requires_input with exact requiredFields such as postal code, house number, phone digits, email, country, date, vessel, or another service-specific value. Ask the user for those values and retry with additional_fields; never guess them. If the carrier must be chosen, first use search_supported_carriers and pass its exact slug. Do not use for bulk monitoring, shipping-label purchases, rate quotes, or delivery changes.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "tracking_number": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "description": "Shipment tracking number or supported tracking URL."
            },
            "language": {
              "default": "en",
              "type": "string",
              "enum": [
                "en",
                "ru",
                "de",
                "es",
                "fr",
                "it",
                "nl",
                "pt",
                "sv",
                "id",
                "ko"
              ]
            },
            "destination_country": {
              "description": "Destination country as an ISO 3166-1 alpha-2 code such as SE, or a full country name in a supported language.",
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            },
            "postal_code": {
              "description": "Destination postal code only when a carrier requires it.",
              "type": "string",
              "minLength": 2,
              "maxLength": 32
            },
            "carrier_slug": {
              "description": "Exact supported carrier slug returned by search_supported_carriers. Omit to use automatic carrier detection.",
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            },
            "additional_fields": {
              "description": "Carrier-required values keyed by the exact names returned in requiredFields. Ask the user and pass values unchanged; never invent them.",
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "required": [
            "tracking_number"
          ]
        },
