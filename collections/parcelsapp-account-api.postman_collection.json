          "name": "Check account usage",
          "request": {
            "name": "Check account usage",
            "description": {
              "content": "Returns the current subscription plan, shipment limit, usage counter, and reset date. On the Mock API server this endpoint returns a fixed demo account and does not require `apiKey`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "account"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "apiKey",
                  "value": "<string>",
                  "description": "(Required) API key from the Parcels dashboard. Not required on the Mock API server."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "6ee0dabd-2c30-4a71-999a-0560d2b46476",
              "name": "Account information or API error.",
              "originalRequest": {
                "url": {
                  "path": [
                    "account"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "apiKey",
                      "value": "pk_live_your_api_key"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"plan\": \"Pro\",\n  \"limit\": 3000,\n  \"current\": 142,\n  \"resetDate\": \"2026-08-01T00:00:00.000Z\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
