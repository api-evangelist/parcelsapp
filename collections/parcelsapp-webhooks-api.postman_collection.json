\"states\": [\n        {\n          \"state\": \"<string>\",\n          \"location\": \"<string>\",\n          \"date\": \"<dateTime>\",\n          \"carrier\": \"<integer>\"\n        },\n        {\n          \"state\": \"<string>\",\n          \"location\": \"<string>\",\n          \"date\": \"<dateTime>\",\n          \"carrier\": \"<integer>\"\n        }\n      ],\n      \"services\": [\n        {\n          \"slug\": \"<string>\",\n          \"name\": \"<string>\"\n        },\n        {\n          \"slug\": \"<string>\",\n          \"name\": \"<string>\"\n        }\n      ],\n      \"detectedCarrier\": {\n        \"slug\": \"<string>\",\n        \"name\": \"<string>\"\n      },\n      \"detected\": [\n        \"<integer>\",\n        \"<integer>\"\n      ],\n      \"attributes\": [\n        {\n          \"l\": \"<string>\",\n          \"n\": \"<string>\",\n          \"val\": \"<string>\",\n          \"code\": \"<string>\"\n        },\n        {\n          \"l\": \"<string>\",\n          \"n\": \"<string>\",\n          \"val\": \"<string>\",\n          \"code\": \"<string>\"\n        }\n      ],\n      \"externalTracking\": [\n        {\n          \"slug\": \"<string>\",\n          \"url\": \"<uri>\",\n          \"trackingId\": \"<string>\",\n          \"method\": \"<string>\"\n        },\n        {\n          \"slug\": \"<string>\",\n          \"url\": \"<uri>\",\n          \"trackingId\": \"<string>\",\n          \"method\": \"<string>\"\n        }\n      ]\n    },\n    {\n      \"trackingId\": \"<string>\",\n      \"status\": \"<string>\",\n      \"origin\": \"<string>\",\n      \"destination\": \"<string>\",\n      \"originCode\": \"<string>\",\n      \"destinationCode\": \"<string>\",\n      \"states\": [\n        {\n          \"state\": \"<string>\",\n          \"location\": \"<string>\",\n          \"date\": \"<dateTime>\",\n          \"carrier\": \"<integer>\"\n        },\n        {\n          \"state\": \"<string>\",\n          \"location\": \"<string>\",\n          \"date\": \"<dateTime>\",\n          \"carrier\": \"<integer>\"\n        }\n      ],\n      \"services\": [\n        {\n          \"slug\": \"<string>\",\n          \"name\": \"<string>\"\n        },\n        {\n          \"slug\": \"<string>\",\n          \"name\": \"<string>\"\n        }\n      ],\n      \"detectedCarrier\": {\n        \"slug\": \"<string>\",\n        \"name\": \"<string>\"\n      },\n      \"detected\": [\n        \"<integer>\",\n        \"<integer>\"\n      ],\n      \"attributes\": [\n        {\n          \"l\": \"<string>\",\n          \"n\": \"<string>\",\n          \"val\": \"<string>\",\n          \"code\": \"<string>\"\n        },\n        {\n          \"l\": \"<string>\",\n          \"n\": \"<string>\",\n          \"val\": \"<string>\",\n          \"code\": \"<string>\"\n        }\n      ],\n      \"externalTracking\": [\n        {\n          \"slug\": \"<string>\",\n          \"url\": \"<uri>\",\n          \"trackingId\": \"<string>\",\n          \"method\": \"<string>\"\n        },\n        {\n          \"slug\": \"<string>\",\n          \"url\": \"<uri>\",\n          \"trackingId\": \"<string>\",\n          \"method\": \"<string>\"\n        }\n      ]\n    }\n  ],\n  \"error\": \"<string>\",\n  \"message\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "79b60fcb-25bf-4854-aa5c-973fcf0f20de",
              "name": "Return any 2xx status after accepting the webhook payload. The response body is ignored.",
              "originalRequest": {
                "url": {
