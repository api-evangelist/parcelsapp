    "name": "Parcels Account Webhooks API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Track packages and shipments worldwide through the Parcels API. Tracking is asynchronous: create a tracking request, then poll by UUID until the result is complete. Use the Mock API server in this documentation to try the flow without an API key or account limits.\n\nContact Support:\n Name: Parcels\n Email: hello@parcelsapp.com",
      "type": "text/plain"
    }
  }
